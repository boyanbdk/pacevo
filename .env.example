NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project settings. Use the service role key only on the server.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_SECRET=replace-with-a-long-random-secret

# Strava API app settings.
STRAVA_CLIENT_ID=your-strava-client-id
STRAVA_CLIENT_SECRET=your-strava-client-secret
STRAVA_WEBHOOK_VERIFY_TOKEN=replace-with-a-random-webhook-verify-token
STRAVA_WEBHOOK_SIGNING_SECRET=your-strava-webhook-signing-secret

